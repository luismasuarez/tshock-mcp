<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TShock.McpServer</RootNamespace>
    <AssemblyName>tshock-mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tshock-mcp</ToolCommandName>
    <PackageId>tshock-mcp</PackageId>
    <Version>0.1.0</Version>
    <Description>MCP server that lets an AI agent operate a TShock Terraria server through its REST API.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

</Project>
